  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#68624C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#884B83"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#615B49"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.template"
      ],
      "settings": {
        "foreground": "#28664E"
      }
    },
    {
      "name": "String escapes and interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#934C22"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#515B99"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#934C22"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#865400"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#245C73"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#28251D"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#344054"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#934C22"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#884B83"
      }
    },
    {
      "name": "Attribute names",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#865400"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#615B49"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#865400"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value",
        "support.constant.color",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#28664E"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#245C73"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#245C73"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#934C22"
      }
    },
    {
      "name": "Regular expression operators",
      "scope": [
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp",
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#884B83"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#865400",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#28251D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#28251D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#245C73"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block punctuation.definition"
      ],
      "settings": {
        "foreground": "#28664E"
      }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": [
        "markup.quote",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#68624C"
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#28664E"
      }
    },
    {
      "name": "Diff deletions",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#A83A44"
      }
    },
    {
      "name": "Diff changes",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#865400"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#A83A44"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#245C73",
    "type": "#245C73",
    "class": "#245C73",
    "enum": "#245C73",
    "interface": "#245C73",
    "struct": "#245C73",
    "typeParameter": "#245C73",
    "parameter": "#28251D",
    "variable": "#28251D",
    "property": "#344054",
    "enumMember": "#934C22",
    "event": "#865400",
    "function": "#865400",
    "method": "#865400",
    "macro": "#934C22",
    "keyword": "#884B83",
    "modifier": "#884B83",
    "comment": {
      "foreground": "#68624C",
      "italic": true
    },
    "string": "#28664E",
    "number": "#515B99",
    "regexp": "#934C22",
    "operator": "#615B49",
    "decorator": "#934C22",
    "variable.readonly": "#934C22",
    "property.readonly": "#934C22",
    "*.defaultLibrary": "#245C73",
    "function.defaultLibrary": "#865400",
    "method.defaultLibrary": "#865400",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
