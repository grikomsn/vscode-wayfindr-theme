  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#3C4934",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#5E3659"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#35432E"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.template"
      ],
      "settings": {
        "foreground": "#2B4822"
      }
    },
    {
      "name": "String escapes and interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#5E3E22"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#373D69"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#5E3E22"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#5E400B"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#244650"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#181D14"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#263120"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#5E3E22"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#5E3659"
      }
    },
    {
      "name": "Attribute names",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#5E400B"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#35432E"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#5E400B"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value",
        "support.constant.color",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#2B4822"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#244650"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#244650"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#5E3E22"
      }
    },
    {
      "name": "Regular expression operators",
      "scope": [
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp",
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#5E3659"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#5E400B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#181D14",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#181D14",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#244650"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block punctuation.definition"
      ],
      "settings": {
        "foreground": "#2B4822"
      }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": [
        "markup.quote",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#3C4934"
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#2B4822"
      }
    },
    {
      "name": "Diff deletions",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#782A2B"
      }
    },
    {
      "name": "Diff changes",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#5E400B"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#782A2B"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#244650",
    "type": "#244650",
    "class": "#244650",
    "enum": "#244650",
    "interface": "#244650",
    "struct": "#244650",
    "typeParameter": "#244650",
    "parameter": "#181D14",
    "variable": "#181D14",
    "property": "#263120",
    "enumMember": "#5E3E22",
    "event": "#5E400B",
    "function": "#5E400B",
    "method": "#5E400B",
    "macro": "#5E3E22",
    "keyword": "#5E3659",
    "modifier": "#5E3659",
    "comment": {
      "foreground": "#3C4934",
      "italic": true
    },
    "string": "#2B4822",
    "number": "#373D69",
    "regexp": "#5E3E22",
    "operator": "#35432E",
    "decorator": "#5E3E22",
    "variable.readonly": "#5E3E22",
    "property.readonly": "#5E3E22",
    "*.defaultLibrary": "#244650",
    "function.defaultLibrary": "#5E400B",
    "method.defaultLibrary": "#5E400B",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
