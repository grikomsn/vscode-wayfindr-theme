    "variable.readonly": "#F1C5A0",
    "property.readonly": "#F1C5A0",
    "*.defaultLibrary": "#B8D8E4",
    "function.defaultLibrary": "#EFBA5A",
    "method.defaultLibrary": "#EFBA5A",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
