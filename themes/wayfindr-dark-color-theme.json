    "macro": "#F1C5A0",
    "keyword": "#D8A4D3",
    "modifier": "#D8A4D3",
    "comment": {
      "foreground": "#ABA18B",
      "italic": true
    },
    "string": "#B1CEB3",
    "number": "#A6B6F1",
    "regexp": "#F1C5A0",
    "operator": "#C3BAA5",
